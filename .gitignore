# secrets
.env

# your actual resume and the profile derived from it
resume.*
my_resume.pdf
profile.json
!profile.example.json
# generated output
out/
*.html
!jobhunt/templates/*.html

# Your dedupe index and application tracker. Personal, and it must never ship
# with the repo: a cloned seen.json marks every job as already-seen, so a new
# user's first run finds nothing. GitHub Actions persists it via actions/cache
# instead of committing it.
seen.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# per-user workspaces under users/ — everything personal lives here
# (.env keys, resume, profile.json, seen.json, out/, inbox job exports).
# Only the sample scaffold ships; real users are created by copying it.
users/*
!users/sample/
# runtime data even inside the scaffold user
users/sample/inbox/
users/sample/out/
users/sample/.env
users/sample/seen.json
users/sample/profile.json
users/sample/resume.*

# local agent/tool state
.claude/settings.local.json
.codebase-memory/
